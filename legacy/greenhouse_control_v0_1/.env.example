# Copy these variables into your shell or a secure systemd EnvironmentFile.
# DO NOT commit or distribute a real password.
HYDRO_BACKEND=simulation
HYDRO_USER=operator
HYDRO_PASSWORD=REPLACE_WITH_LONG_UNIQUE_SECRET
HYDRO_DB=./data/greenhouse.sqlite3
HYDRO_POLL_SECONDS=3

# ONLY for physical device commissioning after confirming bus config:
# HYDRO_BACKEND=modbus
# HYDRO_SERIAL_PORT=/dev/serial/by-id/REPLACE_ME
# HYDRO_RELAY_ID=REPLACE_DEVICE_ADDRESS
# HYDRO_ANALOG_ID=REPLACE_DIFFERENT_DEVICE_ADDRESS
# HYDRO_BAUDRATE=9600
# HYDRO_PARITY=N
# HYDRO_STOPBITS=1
# HYDRO_BENCH_WRITES=0
