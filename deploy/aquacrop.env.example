# /etc/aquacrop/aquacrop.env  (owner root, group aquacrop, mode 0640)
# Path to the validated installation config. Start with a HARDWARE_READ_ONLY profile on the CM4.
AQUACROP_CONFIG=/etc/aquacrop/hardware-read-only.yaml
# Optional: lock directory shared by every installation on this host (one owner per serial port).
# AQUACROP_LOCK_DIR=/run/aquacrop
